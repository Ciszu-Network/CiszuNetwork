{
  "screamingFrog": {
    "title": {
      "maxLength": 60,
      "minLength": 30,
      "empty": "error",
      "duplicate": "error",
      "tooLong": "warning"
    },
    "metaDescription": {
      "maxLength": 160,
      "minLength": 120,
      "empty": "error",
      "duplicate": "warning",
      "tooLong": "warning"
    },
    "h1": {
      "empty": "error",
      "duplicate": "warning",
      "multiplePerPage": "warning",
      "missing": "error"
    },
    "images": {
      "missingAlt": "warning",
      "largeSizeKB": 100,
      "missingWidthHeight": "info"
    },
    "responseCodes": {
      "4xx": "error",
      "5xx": "error",
      "3xxChain": "warning",
      "redirectLoops": "error"
    },
    "canonicals": {
      "missing": "warning",
      "nonSelfRef": "warning",
      "conflictWithHreflang": "error"
    },
    "directives": {
      "noindex": "warning",
      "nofollow": "info",
      "noarchive": "info"
    }
  },
  "lighthouse": {
    "performance": { "mobile": 50, "desktop": 70 },
    "accessibility": { "mobile": 90, "desktop": 95 },
    "bestPractices": { "mobile": 90, "desktop": 95 },
    "seo": { "mobile": 70, "desktop": 90 },
    "lcp": { "mobile": 4000, "desktop": 2500 },
    "cls": { "mobile": 0.25, "desktop": 0.1 },
    "inp": { "mobile": 500, "desktop": 200 }
  },
  "logFileAnalyzer": {
    "crawlBudget": {
      "minPagesPerDay": 10,
      "maxCrawlDepth": 5,
      "orphanPagesThreshold": 0.1
    },
    "botHealth": {
      "googlebotMinVisitsPerWeek": 50,
      "statusCode5xxThreshold": 0.01,
      "statusCode4xxThreshold": 0.05
    }
  }
}