{
  "name": "ciszubot",
  "version": "3.2.0",
  "description": "CiszuBot — bot de Discord en español con prefijo y slash commands (TypeScript)",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsc -w & nodemon dist/src/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ciszunetwork/db": "workspace:*",
    "@ciszunetwork/utils": "workspace:*",
    "@discordjs/voice": "^0.19.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^12.0.1",
    "@sentry/node": "^10.73.0",
    "@top-gg/sdk": "^3.1.6",
    "discord.js": "^14.22.0",
    "discordbotlist": "^1.1.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.3",
    "play-dl": "^1.9.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "nodemon": "^3.0.1",
    "typescript": "^5.9.0"
