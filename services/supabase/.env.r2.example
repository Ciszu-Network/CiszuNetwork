# ─────────────────────────────────────────────
#  Ciszu CDN — Cloudflare R2 Config
#  Copia este archivo como .env.local y rellena
# ─────────────────────────────────────────────

# ID de tu cuenta Cloudflare (dashboard → Workers & Pages → Account ID)
R2_ACCOUNT_ID=

# Access Key del token R2 (R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket (crealo en R2 primero)
R2_BUCKET=ciszu-cdn

# URL pública del bucket R2 (conect domain o r2.dev)
# Ej: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev/ciszu-cdn
# O:   https://cdn.tudominio.com
NEXT_PUBLIC_CDN_URL=