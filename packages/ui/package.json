        "@vitest/browser": "^4.1.11",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "chromatic": "^18.7.2",
        "eslint": "^8.57.1",
        "msw": "^2.15.0",
        "msw-storybook-addon": "^3.0.0",
        "next": "^15.5.25",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sharp": "0.35.3",
        "storybook": "^10.6.0",
        "storybook-addon-tag-badges": "^3.1.0",
