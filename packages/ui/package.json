{
    "name": "@ciszu/ui",
    "version": "1.0.0",
    "description": "Componentes de UI compartidos para Ciszu Network",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./server": "./src/server.ts"
    },
    "scripts": {
