{
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "eslint.validate": ["javascript", "typescript"],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "git.ignoreLimitWarning": true,
    "sqltools.connections": [
        {
            "name": "CiszuNetwork-Supabase",
            "driver": "PostgreSQL",
            "previewLimit": 50,
            "server": "db.YOUR_PROJECT_REF.supabase.co",
            "port": 5432,
            "database": "postgres",
            "username": "postgres",
            "askForPassword": true
        }
    ],
    "cSpell.enabled": false,
    "markdown.validate.enabled": true,
    "material-icon-theme.folders.associations": {
        "logos": "images",
        "banners": "images",
        "gif": "video",
        "gifs": "video",
        "thumbnails": "images",
        "flyers": "images",
        "samples": "examples",
        "isotype": "images",
        "logotype": "images",
        "imagotype": "images",
        "gradient": "theme",
        "monochrome": "theme",
        "holidays": "images",
        "persons": "images",
        "albums": "audio",
        "mc_skin": "theme",
        "arrowskins": "animation",
        "particleskins": "animation",
        "long-videos": "video",
        "not-outline": "images",
        "outline": "images",
        "background": "images",
        "contour": "images",
        "horizontal": "images",
        "vertical": "images",
        "tagline": "images",
        "no-tagline": "images"
    }
}
