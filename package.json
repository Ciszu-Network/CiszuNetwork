{
  "name": "ciszunetwork-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "echo 'Usa: pnpm --filter <app> dev'",
    "build": "echo 'Usa: pnpm --filter <app> build'",
    "lint": "echo 'Usa: pnpm --filter <app> lint'",
    "web:dev": "pnpm --filter ciszunetwork-website dev",
    "web:build": "pnpm --filter ciszunetwork-website build",
    "antony:dev": "pnpm --filter ciszukoantony-website dev",
    "antony:build": "pnpm --filter ciszukoantony-website build",
    "muzicmania:dev": "pnpm --filter muzicmania-website dev",
    "muzicmania:build": "pnpm --filter muzicmania-website build",
    "bot:start": "pnpm --filter ciszubot start",
    "bot:dev": "pnpm --filter ciszubot dev",
    "cdn:upload": "node scripts/upload-cdn.js",
    "cdn:verify": "node scripts/check-cdn-mimes.js",
    "db:backup": "node scripts/backup-db.js",
    "notify": "node scripts/ntfy-notif.js",
    "api:test": "node scripts/run-bru.js run . -r --env prod --exclude-tags local",
    "api:test:report": "node scripts/run-bru.js run . -r --env prod --exclude-tags local --reporter-json ../.opencode-tmp/bru-report.json",
    "api:test:local": "node scripts/run-bru.js run . -r --env prod"
  },
  "devDependencies": {
    "@huggingface/inference": "4.13.24",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.8.1"
}
